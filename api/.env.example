# Connexion PostgreSQL 16+
DATABASE_URL=postgres://hotel:hotel@localhost:5432/hotel
# Obligatoire en production : chaîne aléatoire d'au moins 32 caractères
JWT_SECRET=
PORT=3000
PUBLIC_BASE_URL=https://api.hotel.local
HOTEL_NAME=Hotel
HOTEL_TZ=Europe/Paris
HOTEL_CURRENCY=EUR
# Suppléments pension par personne et par nuit, en centimes
HALF_BOARD_SUPPLEMENT=2500
FULL_BOARD_SUPPLEMENT=4500
# Modules activés (le menu dynamique n'affiche que ceux-ci) : core, restaurant…
ENABLED_MODULES=core
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=10
# Mettre à false pour exécuter les migrations séparément
MIGRATIONS_RUN=true
# Proxys dont l'en-tête X-Forwarded-For est pris en compte (serveur web, répartiteur)
TRUST_PROXY=loopback
