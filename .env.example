# Copier vers .env (lu automatiquement par docker compose) :
#   cp .env.example .env && sed -i "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 32)/" .env
# Obligatoire : chaîne aléatoire d'au moins 32 caractères
JWT_SECRET=
HOTEL_NAME=Hotel
HOTEL_TZ=Europe/Paris
# Modules activés : core (toujours), restaurant (facturation à la chambre depuis le restaurant)
ENABLED_MODULES=core,restaurant
# Mettre à true dès que l'application est servie en HTTPS
COOKIE_SECURE=false
